# Database Configuration (PostgreSQL running via Docker on port 5433)
DATABASE_URL=postgresql://campusgate:campusgate_secret@localhost:5433/campusgate_db
FALLBACK_SQLITE_URL=sqlite:///./campusgate.db

# Postgres Docker Configuration
POSTGRES_USER=campusgate
POSTGRES_PASSWORD=campusgate_secret
POSTGRES_DB=campusgate_db
POSTGRES_PORT=5433

# Application Settings
ENVIRONMENT=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=*

# Vision Settings
VISION_WEIGHTS_PATH=backend/vision/weights/best.pt
DETECTION_CONF_THRESHOLD=0.35
PLATE_QUALITY_MIN_SCORE=0.40
